<?xml version="1.0" encoding="utf-8"?>
<!--
    Same backup policy as data_extraction_rules.xml, for Android 11 and below:
    settings (DataStore) are backed up, the Room database is not.
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <exclude domain="database" path="." />
</full-backup-content>